# syntax = docker/dockerfile:1
#
# The production image (Dockerfile) on Ruby built from ruby/ruby master instead of a release.
# BUNDLE_VERSION=system keeps the Bundler that ships with master: otherwise it re-execs
# bin/campfire under the lockfile's Bundler, dropping the JIT flag bin/boot passed.
#
#   docker build -f Dockerfile.head --build-arg RUBY_REF=<sha> -t campfire-ruby:head .

ARG RUBY_REF=master

FROM docker.io/library/debian:trixie-slim AS ruby
ARG RUBY_REF
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential autoconf bison rustc ruby git ca-certificates \
      libssl-dev libyaml-dev libffi-dev zlib1g-dev libgmp-dev libreadline-dev && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives
RUN git clone --filter=blob:none https://github.com/ruby/ruby /src/ruby && cd /src/ruby && git checkout "$RUBY_REF" && \
    ./autogen.sh && ./configure --prefix=/usr/local --with-baseruby=/usr/bin/ruby --enable-shared --enable-yjit --disable-install-doc && \
    make -j"$(nproc)" && make install && cd / && rm -rf /src/ruby && ruby -v


FROM docker.io/library/debian:trixie-slim AS base
WORKDIR /rails
ENV BUNDLE_DEPLOYMENT=1 BUNDLE_PATH=/usr/local/bundle BUNDLE_WITHOUT=development:test \
    GEM_HOME=/usr/local/bundle LANG=C.UTF-8 TZ=UTC PATH=/usr/local/bundle/bin:$PATH \
    BUNDLE_VERSION=system
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y libsqlite3-0 libvips-tools ffmpeg libjemalloc2 curl \
      libssl3t64 libyaml-0-2 libffi8 zlib1g libgmp10 libreadline8t64 ca-certificates && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives
COPY --from=ruby /usr/local /usr/local


FROM base AS build
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential pkg-config libsqlite3-dev libssl-dev libvips-dev git && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives
COPY Gemfile Gemfile.lock ./
COPY vendor/gems vendor/gems
RUN cd vendor/gems/extralite/ext/extralite && ruby extconf.rb && make -j"$(nproc)" && \
    cp extralite_ext.so ../../lib/ && make clean && rm -f Makefile mkmf.log
RUN bundle install --jobs "$(nproc)" && \
    rm -rf "${BUNDLE_PATH}"/ruby/*/cache "${BUNDLE_PATH}"/ruby/*/bundler/gems/*/.git
COPY . .
RUN cd ext/campfire_vips && ruby extconf.rb && make -j"$(nproc)" && \
    cp campfire_vips.so ../../lib/ && make clean && rm -f Makefile mkmf.log


FROM base
COPY --from=build /usr/local/bundle /usr/local/bundle
COPY --from=build /rails /rails
RUN groupadd --system --gid 1000 rails && \
    useradd rails --uid 1000 --gid 1000 --create-home --shell /bin/bash && \
    mkdir -p /rails/storage/db /rails/storage/files /rails/tmp && \
    chown -R 1000:1000 /rails/storage /rails/tmp
USER 1000:1000

ARG APP_VERSION=0
ARG GIT_REVISION=0
ENV APP_VERSION=${APP_VERSION} GIT_REVISION=${GIT_REVISION} HTTP_PORT=80 \
    LD_PRELOAD=libjemalloc.so.2 RUBY_YJIT_ENABLE=1
EXPOSE 80
CMD ["bin/boot"]
