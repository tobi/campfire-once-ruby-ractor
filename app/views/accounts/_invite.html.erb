<div class="flex flex-column align-center gap">
  <% url = "#{base_url}/join/#{account.join_code}" %>

  <label class="flex flex-column gap full-width" style="--row-gap: 0.5em">
    <strong id="invite_label" class="invite-label">Share to invite more people</strong>
    <span class="flex align-center gap input input--actor fill-white">
      <img aria-hidden="true" class="colorize--black" src="<%== asset_path("person-add.svg") %>" width="20" height="20" />
      <input type="text" class="input" id="invite_url" value="<%= url %>" aria-labelledby="invite_label" readonly>
    </span>
  </label>

  <div class="flex align-center gap">
    <%= qr_code_link_open(url) %>
      <span class="for-screen-reader">Show join link QR code</span>
      <img aria-hidden="true" class="colorize--black" src="<%== asset_path("qr-code.svg") %>" width="20" height="20" />
</a>
    <%= copy_to_clipboard_open(url) %>
      <span class="for-screen-reader">Copy join link</span>
      <img aria-hidden="true" class="colorize--black" src="<%== asset_path("copy-paste.svg") %>" width="20" height="20" />
</button>
    <%= web_share_open(url, "Link to join Campfire", "Hit this link to join me in Campfire and start chatting.") %>
      <span class="for-screen-reader">Share join link</span>
      <img aria-hidden="true" class="colorize--black" src="<%== asset_path("share.svg") %>" width="20" height="20" />
</button>
<% if current_user.can_administer? %>
      <form class="button_to" method="post" action="/account/join_code"><button class="btn btn--regenerate" type="submit">
        <img aria-hidden="true" class="colorize--black" src="<%== asset_path("refresh.svg") %>" width="20" height="20" />
        <span class="for-screen-reader">Regenerate join link</span>
</button></form><%= nil -%>
<% end %>
  </div>
</div>
