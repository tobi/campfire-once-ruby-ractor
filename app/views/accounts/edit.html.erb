

<section class="panel txt-align-center flex flex-column gap" style="view-transition-name: account-settings">
<% if current_user.can_administer? %>
<% action = "/account.#{@account.id}" %>
    <div class="align-center center avatar__form gap" data-controller="upload-preview">
      <form class="txt--medium" data-controller="form" enctype="multipart/form-data" action="<%= action %>" accept-charset="UTF-8" method="post"><input type="hidden" name="_method" value="patch" /><%= form_token(action, "patch") %>
        <label class="btn input--file">
          <img aria-hidden="true" src="<%== asset_path("camera.svg") %>" width="20" height="20" />
          <input class="input" accept="image/*" data-action="upload-preview#previewImage change-&gt;form#submit" type="file" name="account[logo]" id="account_logo" />
          <span class="for-screen-reader">Upload logo</span>
        </label>
</form>
      <form data-controller="form" enctype="multipart/form-data" action="<%= action %>" accept-charset="UTF-8" method="post"><input type="hidden" name="_method" value="patch" /><%= form_token(action, "patch") %>
        <label class="btn avatar input--file account-logo txt-xx-large">
          <img role="presentation" data-upload-preview-target="image" src="<%= fresh_account_logo_path %>" width="48" height="48" />
          <input class="input" accept="image/*" data-action="upload-preview#previewImage change-&gt;form#submit" type="file" name="account[logo]" id="account_logo" />
          <span class="for-screen-reader">Upload logo</span>
        </label>
</form>
<% if @account.logo_attached?(@db) %>
<% logo_path = fresh_account_logo_path %>
        <form class="button_to" method="post" action="<%= logo_path %>"><input type="hidden" name="_method" value="delete" /><button class="btn btn--negative txt-small avatar__delete-btn" type="submit">
          <img aria-hidden="true" src="<%== asset_path("minus.svg") %>" width="20" height="20" />
          <span class="for-screen-reader">Delete logo</span>
</button><%= form_token("/account/logo", "delete") %></form><%= nil -%>
<% end %>
    </div>

    <form class="flex flex-column gap" data-controller="form" action="<%= action %>" accept-charset="UTF-8" method="post"><input type="hidden" name="_method" value="patch" /><%= form_token(action, "patch") %>
      <div class="flex align-center gap">
        <%= translation_button(:account_name) %>

        <label class="flex align-center gap flex-item-grow">
          <input class="input txt-large" autocomplete="off" placeholder="Name this account" autofocus="autofocus" data-action="keydown.enter-&gt;form#submit" type="text" value="<%= @account.name %>" name="account[name]" id="account_name" />
        </label>

        <button name="button" type="submit" class="btn btn--reversed center">
          <img aria-hidden="true" src="<%== asset_path("check.svg") %>" width="20" height="20" />
          <span class="for-screen-reader">Save changes</span>
</button>      </div>
</form>
    <div class="margin-block-start pad-block pad-inline-double fill-shade border-radius">
      <form class="flex align-center gap center" data-controller="form" action="<%= action %>" accept-charset="UTF-8" method="post"><input type="hidden" name="_method" value="put" /><%= form_token(action, "put") %>
        <div class="flex-item-grow flex align-center gap txt-align-start">
          <img class="colorize--black" aria-hidden="true" src="<%== asset_path("crown.svg") %>" width="18" height="18" /> Must be admin to create new rooms
        </div>
        
          <input value="<%== @account.restrict_room_creation_to_administrators? ? "false" : "true" %>" type="hidden" name="account[settings][restrict_room_creation_to_administrators]" id="account_settings_restrict_room_creation_to_administrators" />

        <label class="switch">
          <input type="checkbox"
                class="switch__input"
                <%== "checked" if @account.restrict_room_creation_to_administrators? %>
                data-action="change->form#submit">
          <span class="switch__btn round"></span>
          <span class="for-screen-reader">
            Must be admin to create new rooms
          </span>
        </label>

</form>    </div>
<% else %>
    <%= account_logo_tag(style: "txt-xx-large center") %>
    <h1 class="flex-item-grow txt-x-large"><%= @account.name %></h1>
<% end %>

  <div class="margin-block pad-inline pad-block-start fill-shade border-radius">
    <%= _accounts_invite %>

    <hr class="margin-block separator full-width" style="--border-style: solid">

    <menu class="flex flex-column gap margin-none pad">
      <turbo-frame id="account_users">
<% admin_view = current_user.can_administer? %>
        <%= (@administrators.each { |u| _accounts_users_user(user: u, admin_view: admin_view) }; nil) %>

<% if !@administrators.empty? && !@members.empty? %>
          <hr class="separator full-width" style="--border-style: solid">
<% end %>

        <%= (@members.each { |u| _accounts_users_user(user: u, admin_view: admin_view) }; nil) %>
        <%= _accounts_users_next_page_container(page: 2) unless @last_page %>
      </turbo-frame>
    </menu>
  </div>
</section>

