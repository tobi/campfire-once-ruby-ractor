<% path = "/account/bots/#{@bot.id}" %>


<section class="panel" style="view-transition-name: chat-bot-<%= @bot.id %>">
  <form class="flex flex-column gap" enctype="multipart/form-data" action="<%= path %>" accept-charset="UTF-8" method="post"><input type="hidden" name="_method" value="patch" /><%= form_token(path, "patch") %>
    <%= _accounts_bots_form(name: @bot.name, webhook_url: @webhook_url, avatar_blob: @avatar_blob) %>
</form>
  <hr class="separator full-width margin-block-double">

  <div class="flex align-center gap justify-space-between">
    <form class="button_to" method="post" action="<%= path %>"><input type="hidden" name="_method" value="delete" /><button class="btn txt--small btn--negative" aria-label="Delete this chat bot" data-turbo-confirm="Are you sure you want to permanently remove this bot from the account? This can’t be undone." type="submit">
      <img aria-hidden="true" src="<%== asset_path("trash.svg") %>" width="20" height="20" />
      <img aria-hidden="true" src="<%== asset_path("bot.svg") %>" width="20" height="20" />
</button><%= form_token(path, "delete") %></form>
    <form class="button_to" method="post" action="<%= path %>/key"><input type="hidden" name="_method" value="put" /><button class="btn full-width txt--small btn--negative" aria-label="Generate a new key" data-turbo-confirm="Are you sure you want to change the bot key? All usage of this bot must be updated." type="submit">
      <img aria-hidden="true" src="<%== asset_path("refresh.svg") %>" width="20" height="20" />
      <img aria-hidden="true" src="<%== asset_path("key.svg") %>" width="20" height="20" />
</button><%= form_token("#{path}/key", "put") %></form>  </div>
</section>
