<%# locals: (id:, name:, updated_at:) %>
<form class="button_to" method="post" action="/rooms/directs?user_ids%5B%5D=<%== id %>"><button class="direct borderless fill-transparent unpad" type="submit">
  <span class="avatar">
    <img aria-hidden="true" src="<%== fresh_user_avatar_path(id, updated_at) %>" />
  </span>

  <span class="direct__author flex align-center gap max-width min-width border-radius txt-small">
    <span class="txt-nowrap overflow-ellipsis">
      <span class="for-screen-reader">Start a ping with</span>
      <%= first_word(name) %>
    </span>
  </span>
</button>