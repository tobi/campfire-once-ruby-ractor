<%# locals: (user:) %>
<% url = "#{base_url}/session/transfers/#{Campfire.secrets.signed_id("User", user.id, purpose: "transfer", expires_at: Time.now + 4 * 3600)}" %>

<fieldset>
  <legend class="gap">
    <img aria-hidden="true" class="colorize--black" src="<%== asset_path("laptop.svg") %>" width="36" height="36" />
    <img aria-hidden="true" class="colorize--black" src="<%== asset_path("transfer.svg") %>" width="36" height="36" />
    <img aria-hidden="true" class="colorize--black" src="<%== asset_path("mobile-phone.svg") %>" width="36" height="36" />
  </legend>


  <div class="flex flex-column gap">
<% if current_user.id != user.id %>
      <div class="flex align-center gap justify-center">
        <img aria-hidden="true" class="flex-item-no-shrink colorize--black" src="<%== asset_path("crown.svg") %>" width="16" height="16" />
        <label for="session_transfer_url">Share to get them back into their account</label>
      </div>
<% else %>
      <label for="session_transfer_url" class="for-screen-reader">Use this link to login automatically on another device</label>
<% end %>

    <input type="text" class="input" value="<%= url %>" id="session_transfer_url" readonly>

    <div class="flex align-center center gap">
      <%= qr_code_link_open(url) %>
        <span class="for-screen-reader">Show auto-login QR code</span>
        <img aria-hidden="true" class="colorize--black" src="<%== asset_path("qr-code.svg") %>" width="20" height="20" />
</a>
      <%= copy_to_clipboard_open(url) %>
        <span class="for-screen-reader">Copy auto-login link</span>
        <img aria-hidden="true" class="flex-item-no-shrink colorize--black" src="<%== asset_path("copy-paste.svg") %>" width="20" height="20" />
</button>
      <%= web_share_open(url, "Your sign-in link", "This is your own private sign-in URL, DO NOT SHARE IT. Use it to sign-in on another device or if you get locked out.") %>
        <span class="for-screen-reader">Share auto-login link</span>
        <img aria-hidden="true" class="flex-item-no-shrink colorize--black" src="<%== asset_path("share.svg") %>" width="20" height="20" />
</button>    </div>
  </div>
</fieldset>
