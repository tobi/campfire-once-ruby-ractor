

<div class="panel txt-align-center">
  <section class="directs--edit margin-block-end">
<% @users.each do |user| %>
      <div class="member flex flex-column gap fill-shade pad border-radius">
        <figure class="avatar center" style="--avatar-border-radius: 10ch; --avatar-size: 10ch;" >
          <%= lazy_avatar_tag(user) %>
        </figure>

        <strong><%= user.name %></strong>
      </div>
<% end %>
  </section>

<% action = "#{base_url}/rooms/directs/#{@room.id}" %>
  <form class="button_to" method="post" action="<%= action %>"><input type="hidden" name="_method" value="delete" /><button class="btn btn--negative center" aria-label="Delete Ping" data-turbo-confirm="Are you sure you want to delete this ping and all messages in it? This can’t be undone." type="submit">
    <img aria-hidden="true" src="<%== asset_path("trash.svg") %>" />
    Ping
</button><%= form_token(action, "delete") %></form></div>
