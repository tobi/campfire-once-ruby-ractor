<%# locals: (user:, admin:, selected:, new_record:) %>
<li class="flex align-center gap margin-none" data-value="<%= user.name.downcase %>">
  <figure class="avatar flex-item-no-shrink" style="--avatar-size: 4ch;">
    <%= lazy_avatar_tag(user) %>
  </figure>

  <div class="min-width">
    <div class="overflow-ellipsis fill-shade"><strong><%= user.name %></strong></div>
  </div>

  <hr class="separator" aria-hidden="true">

<% if admin %>
<% if user.id == current_user.id && new_record %>
      <input type="hidden" name="user_ids[]" value="<%= user.id %>" />
      <img class="colorize--black flex-item-no-shrink" aria-hidden="true" src="<%== asset_path("check.svg") %>" width="20" height="20" />
<% else %>
      <label class="switch flex-item-no-shrink">
        <input type="checkbox" name="user_ids[]" value="<%= user.id %>" class="switch__input"<% if selected %> checked="checked"<% end %> />
        <span class="switch__btn round"></span>
        <span class="for-screen-reader">Give <%= user.name %> access to this room</span>
      </label>
<% end %>
<% end %>
</li>
